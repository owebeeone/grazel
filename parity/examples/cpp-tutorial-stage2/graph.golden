action 'Linking main/libhello-greet.a'
  Mnemonic: CppArchive
  Target: //main:hello-greet
  Inputs: [bazel-out/<cfg>/bin/main/_objs/hello-greet/hello-greet.o, external/<repo>/builtin_include_directory_paths, external/<repo>/cc_wrapper.sh, external/<repo>/deps_scanner_wrapper.sh, external/<repo>/validate_static_library.sh]
  Outputs: [bazel-out/<cfg>/bin/main/libhello-greet.a]
  Environment: [PATH=/bin:/usr/bin:/usr/local/bin, PWD=/proc/self/cwd, ZERO_AR_DATE=1]
  Command Line: (exec /usr/bin/libtool \
    -D \
    -no_warning_for_no_symbols \
