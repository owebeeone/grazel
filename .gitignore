.DS_Store
.venv/
__pycache__/
.pytest_cache/
.coverage
htmlcov/
*.pyc
build/
dist/
*.egg-info/
tests/.uv-venvs/
tests/actual_test_results/
scratch/
*-old.py

# Rust (Cargo) build output — never committed
/target

# Bazel convenience symlinks (parity golden capture, anywhere bazel runs)
bazel-*
# Razel output base + convenience symlinks — anchored to repo root so they do
# NOT match the crates/razel-* package dirs (bare razel-* would hide new sources).
/razel-out
/razel-bin
/razel-testlogs
.claude/
.razel-cache/
.razel-crates/

# Compiled Rust artifacts left in the tree (e.g. parity corpus build outputs)
*.rlib
