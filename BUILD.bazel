# Workspace root. crate_universe (MODULE.bazel) reads these manifests; expose them as
# source files so `//:Cargo.toml` / `//:Cargo.lock` labels resolve.
exports_files([
    "Cargo.toml",
    "Cargo.lock",
])

# Top-level convenience handles for the two shipped binaries. The canonical rust_binary
# targets live in their crates; these aliases make `bazel build //:razel` / `bazel run //:grazel`
# work from the workspace root without duplicating the dep lists.
alias(
    name = "razel",
    actual = "//crates/razel-cli:razel",
    visibility = ["//visibility:public"],
)

alias(
    name = "grazel",
    actual = "//crates/grazel-cli:grazel",
    visibility = ["//visibility:public"],
)

# `bazel test //:test_all` — every NON-manual rust_test across the workspace.
#
# Manual-tagged tests are intentionally excluded (they're sandbox-hostile and run via cargo):
# the cc/java graph-parity carve-outs (`razel-loading:{graph,java_graph}_parity_test`), the
# node-spawning cli verbs (`razel-cli:{run,test}_verb_test`), the daemon/socket e2e
# (`grazel-cli:ws_test_test`, `razel-cli:cli_test`), the cargo-spawning
# `razel-build:rust_rules_test`, and `grazel-cli-lib:grazel_cli_lib_unit`.
#
# This is an explicit list (the named target requested); `bazel test //...` is the
# always-current equivalent that needs no maintenance. Refresh this list when tests are
# added: `kind("rust_test rule", //crates/...) except attr(tags, "manual", //crates/...)`.
test_suite(
    name = "test_all",
    tests = [
        "//crates/grazel-node:grazel_node_unit",
        "//crates/razel-actions:razel_actions_unit",
        "//crates/razel-analysis:razel_analysis_unit",
        "//crates/razel-build:py_rules_test",
        "//crates/razel-build:razel_build_unit",
        "//crates/razel-build:sh_rules_test",
        "//crates/razel-cc-toolchain:razel_cc_toolchain_unit",
        "//crates/razel-cli:cli_build_test",
        "//crates/razel-cli:razel_cli_unit",
        "//crates/razel-conformance:razel_conformance_unit",
        "//crates/razel-core:razel_core_unit",
        "//crates/razel-daemon:razel_daemon_unit",
        "//crates/razel-daemon:rpc_socket_test",
        "//crates/razel-daemon:transcript_test",
        "//crates/razel-dds:razel_dds_unit",
        "//crates/razel-deps-engine:facts_test",
        "//crates/razel-deps-engine:seam_test",
        "//crates/razel-engine:razel_engine_unit",
        "//crates/razel-exec:razel_exec_unit",
