load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary", "rust_test")
load("@crates//:defs.bzl", "aliases", "all_crate_deps")

exports_files(["Cargo.toml"])  # crate_universe reads this

rust_library(
    name = "razel_loading",
    srcs = ["src/lib.rs"] + glob(["src/**/*.rs"], exclude = ["src/lib.rs"], allow_empty = True),
    crate_root = "src/lib.rs",
    edition = "2024",
    # host.rs include_str!s a tree of reference Bazel repo files; the 14 dirs holding an
    # embedded `BUILD` are sub-packages (the glob stops at them), so pull them in explicitly.
    compile_data = glob(["**/*"], exclude = ["**/*.rs", "BUILD.bazel", "Cargo.toml"], allow_empty = True) + [
        "//crates/razel-loading/host-repos/bazel_features:files",
        "//crates/razel-loading/host-repos/bazel_tools/src/conditions:files",
        "//crates/razel-loading/host-repos/bazel_tools/tools/cpp:files",
        "//crates/razel-loading/host-repos/bazel_tools/tools/proto:files",
        "//crates/razel-loading/host-repos/cc_compatibility_proxy:files",
        "//crates/razel-loading/host-repos/compatibility_proxy:files",
        "//crates/razel-loading/host-repos/local_config_cuda/cuda:files",
        "//crates/razel-loading/host-repos/local_config_nccl:files",
        "//crates/razel-loading/host-repos/local_config_rocm/rocm:files",
        "//crates/razel-loading/host-repos/local_config_sycl/sycl:files",
        "//crates/razel-loading/host-repos/local_config_tensorrt:files",
        "//crates/razel-loading/host-repos/nvshmem:files",
        "//crates/razel-loading/host-repos/proto_bazel_features:files",
        "//crates/razel-loading/host-repos/rules_python/python:files",
        # P5.0 query slice (host.rs `include_str!`s these for the q4 `@platforms`/`@rules_rust//rust/platform` graph).
        "//crates/razel-loading/host-repos/platforms:files",
        "//crates/razel-loading/host-repos/platforms/cpu:files",
        "//crates/razel-loading/host-repos/platforms/os:files",
        "//crates/razel-loading/host-repos/rules_rust/rust/platform:files",
    ],
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [
        "//crates/razel-cc-toolchain:razel_cc_toolchain",
        "//crates/razel-core:razel_core",
        "//crates/razel-dds:razel_dds",
        "//crates/razel-ir:razel_ir",
        "//crates/razel-rulepack:razel_rulepack",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
)

