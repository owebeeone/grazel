load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary", "rust_test")

exports_files(["Cargo.toml"])  # crate_universe reads this

rust_library(
    name = "razel_deps_engine",
    srcs = ["src/lib.rs"] + glob(["src/**/*.rs"], exclude = ["src/lib.rs"], allow_empty = True),
    crate_root = "src/lib.rs",
    edition = "2024",
    compile_data = glob(["**/*"], exclude = ["**/*.rs", "BUILD.bazel", "Cargo.toml"], allow_empty = True),
    deps = [
        "//crates/razel-core:razel_core",
        "//crates/razel-dds:razel_dds",
        "//crates/razel-loading:razel_loading",
        "//crates/razel-wire:razel_wire",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "facts_test",
    srcs = ["tests/facts.rs"],
    crate_root = "tests/facts.rs",
    edition = "2024",
    compile_data = glob(["**/*"], exclude = ["**/*.rs", "BUILD.bazel", "Cargo.toml"], allow_empty = True),
    deps = [
        "//crates/razel-core:razel_core",
        "//crates/razel-dds:razel_dds",
        "//crates/razel-deps-engine:razel_deps_engine",
        "//crates/razel-loading:razel_loading",
        "//crates/razel-wire:razel_wire",
    ],
)

rust_test(
    name = "seam_test",
    srcs = ["tests/seam.rs"],
    crate_root = "tests/seam.rs",
    edition = "2024",
    compile_data = glob(["**/*"], exclude = ["**/*.rs", "BUILD.bazel", "Cargo.toml"], allow_empty = True),
    deps = [
        "//crates/razel-core:razel_core",
        "//crates/razel-dds:razel_dds",
        "//crates/razel-deps-engine:razel_deps_engine",
        "//crates/razel-loading:razel_loading",
        "//crates/razel-wire:razel_wire",
    ],
)
