load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary", "rust_test")
load("@crates//:defs.bzl", "aliases", "all_crate_deps")

exports_files(["Cargo.toml"])  # crate_universe reads this

rust_library(
    name = "razel_cli",
    srcs = ["src/lib.rs"] + glob(["src/**/*.rs"], exclude = ["src/lib.rs"] + ["src/main.rs"], allow_empty = True),
    crate_root = "src/lib.rs",
    edition = "2024",
    compile_data = glob(["**/*"], exclude = ["**/*.rs", "BUILD.bazel", "Cargo.toml"], allow_empty = True),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [
        "//crates/razel-build:razel_build",
        "//crates/razel-core:razel_core",
        "//crates/razel-daemon:razel_daemon",
        "//crates/razel-exec:razel_exec",
        "//crates/razel-wire:razel_wire",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "razel",
    srcs = ["src/main.rs"],
    crate_root = "src/main.rs",
    edition = "2024",
    compile_data = glob(["**/*"], exclude = ["**/*.rs", "BUILD.bazel", "Cargo.toml"], allow_empty = True),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [
        "//crates/razel-build:razel_build",
        "//crates/razel-cli:razel_cli",
        "//crates/razel-core:razel_core",
        "//crates/razel-daemon:razel_daemon",
        "//crates/razel-exec:razel_exec",
        "//crates/razel-wire:razel_wire",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
)

rust_test(
    name = "razel_cli_unit",
    crate = ":razel_cli",
    edition = "2024",
    compile_data = glob(["**/*"], exclude = ["**/*.rs", "BUILD.bazel", "Cargo.toml"], allow_empty = True),
    deps = all_crate_deps(normal_dev = True),
)

rust_test(
    name = "cli_test",
    srcs = ["tests/cli.rs"],
    crate_root = "tests/cli.rs",
    edition = "2024",
    # Cargo sets CARGO_BIN_EXE_razel for integration tests; bazel doesn't — provide it
    # (compile-time, since the test uses env!) + stage the binary in runfiles via data.
    data = ["//crates/razel-cli:razel"],
    rustc_env = {"CARGO_BIN_EXE_razel": "$(rootpath //crates/razel-cli:razel)"},
    compile_data = glob(["**/*"], exclude = ["**/*.rs", "BUILD.bazel", "Cargo.toml"], allow_empty = True),
    aliases = aliases(),
    deps = all_crate_deps(normal_dev = True) + [
        "//crates/razel-build:razel_build",
        "//crates/razel-cli:razel_cli",
        "//crates/razel-core:razel_core",
        "//crates/razel-daemon:razel_daemon",
        "//crates/razel-exec:razel_exec",
        "//crates/razel-wire:razel_wire",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
)

