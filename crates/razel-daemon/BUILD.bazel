load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary", "rust_test")
load("@crates//:defs.bzl", "aliases", "all_crate_deps")

exports_files(["Cargo.toml"])  # crate_universe reads this

rust_library(
    name = "razel_daemon",
    srcs = ["src/lib.rs"] + glob(["src/**/*.rs"], exclude = ["src/lib.rs"], allow_empty = True),
    crate_root = "src/lib.rs",
    edition = "2024",
    compile_data = glob(["**/*"], exclude = ["**/*.rs", "BUILD.bazel", "Cargo.toml"], allow_empty = True),
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [
        "//crates/razel-build:razel_build",
        "//crates/razel-core:razel_core",
        "//crates/razel-engine:razel_engine",
        "//crates/razel-exec:razel_exec",
        "//crates/razel-ir:razel_ir",
        "//crates/razel-wire:razel_wire",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
)

rust_test(
    name = "razel_daemon_unit",
    crate = ":razel_daemon",
    edition = "2024",
    compile_data = glob(["**/*"], exclude = ["**/*.rs", "BUILD.bazel", "Cargo.toml"], allow_empty = True),
    deps = all_crate_deps(normal_dev = True),
)

rust_test(
    name = "rpc_socket_test",
    srcs = ["tests/rpc_socket.rs"],
    crate_root = "tests/rpc_socket.rs",
    edition = "2024",
    compile_data = glob(["**/*"], exclude = ["**/*.rs", "BUILD.bazel", "Cargo.toml"], allow_empty = True),
    aliases = aliases(),
    deps = all_crate_deps(normal_dev = True) + [
        "//crates/razel-build:razel_build",
        "//crates/razel-core:razel_core",
        "//crates/razel-daemon:razel_daemon",
        "//crates/razel-engine:razel_engine",
        "//crates/razel-exec:razel_exec",
        "//crates/razel-ir:razel_ir",
        "//crates/razel-wire:razel_wire",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
)

rust_test(
    name = "transcript_test",
    srcs = ["tests/transcript.rs"],
    crate_root = "tests/transcript.rs",
    edition = "2024",
    compile_data = glob(["**/*"], exclude = ["**/*.rs", "BUILD.bazel", "Cargo.toml"], allow_empty = True),
    aliases = aliases(),
    deps = all_crate_deps(normal_dev = True) + [
        "//crates/razel-build:razel_build",
        "//crates/razel-core:razel_core",
        "//crates/razel-daemon:razel_daemon",
        "//crates/razel-engine:razel_engine",
        "//crates/razel-exec:razel_exec",
        "//crates/razel-ir:razel_ir",
        "//crates/razel-wire:razel_wire",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
)
